#!/bin/zsh
set -eu

APP_CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
APP_SOURCE="$APP_CONTENTS/Resources/app"
SUPPORT="$HOME/Library/Application Support/Grabbr"
VERSION="45.4.1"
ARCHIVE="electron-v$VERSION-darwin-arm64.zip"
RUNTIME_DIR="$SUPPORT/Runtime-$VERSION-arm64"
RUNTIME_APP="$RUNTIME_DIR/Grabbr Runtime.app"
RUNTIME_BIN="$RUNTIME_APP/Contents/MacOS/Electron"

show_error() {
  /usr/bin/osascript -e 'on run argv' -e 'display alert "Grabbr kon niet starten" message (item 1 of argv) as critical buttons {"OK"} default button "OK"' -e 'end run' -- "$1" >/dev/null 2>&1 || true
}

verify_official_archive() {
  local zip="$1" sums="$2" expected actual
  expected="$(/usr/bin/awk -v name="$ARCHIVE" '$2 == name || $2 == "*" name { print $1; exit }' "$sums")"
  if [ -z "$expected" ]; then return 1; fi
  actual="$(/usr/bin/shasum -a 256 "$zip" | /usr/bin/awk '{print $1}')"
  [ "$actual" = "$expected" ]
}

verify_archive_layout() {
  local zip="$1" listing="$2" root count required
  /usr/bin/unzip -tq "$zip" >/dev/null 2>&1 || return 1
  /usr/bin/unzip -Z1 "$zip" >"$listing" || return 1

  # The official runtime must contain one complete, top-level Electron.app. Do
  # not search for an arbitrary nested/partial app after extraction.
  count="$(/usr/bin/awk -F/ '$1 == "Electron.app" && $2 == "Contents" && $3 == "MacOS" && $4 == "Electron" { count++ } END { print count+0 }' "$listing")"
  [ "$count" -eq 1 ] || return 1
  root="Electron.app"
  for required in \
    "$root/Contents/Info.plist" \
    "$root/Contents/MacOS/Electron" \
    "$root/Contents/_CodeSignature/CodeResources" \
    "$root/Contents/Resources/default_app.asar" \
    "$root/Contents/Frameworks/Electron Framework.framework/Versions/A/Electron Framework"; do
    /usr/bin/grep -Fqx "$required" "$listing" || return 1
  done
}

preflight_extracted_bundle() {
  local electron_app="$1" zip="$2" diagnosis="$3" archive_hash extracted_hash framework_current
  : >"$diagnosis"
  if [ ! -d "$electron_app" ]; then echo 'Electron.app ontbreekt op de verwachte top-level locatie.' >>"$diagnosis"; return 1; fi
  for directory in Contents Contents/Resources Contents/Frameworks Contents/_CodeSignature; do
    if [ ! -d "$electron_app/$directory" ]; then echo "Ontbrekende directory: Electron.app/$directory" >>"$diagnosis"; fi
  done
  for file in \
    Contents/Info.plist \
    Contents/MacOS/Electron \
    Contents/_CodeSignature/CodeResources \
    Contents/Resources/default_app.asar \
    'Contents/Frameworks/Electron Framework.framework/Versions/A/Electron Framework'; do
    if [ ! -s "$electron_app/$file" ]; then echo "Ontbrekend of leeg bestand: Electron.app/$file" >>"$diagnosis"; fi
  done
  if [ -s "$diagnosis" ]; then return 1; fi
  [ -x "$electron_app/Contents/MacOS/Electron" ] || { echo 'Electron executable heeft geen execute-bit.' >>"$diagnosis"; return 1; }
  /usr/bin/find "$electron_app/Contents/Resources" -mindepth 1 -print -quit | /usr/bin/grep -q . || { echo 'Electron.app/Contents/Resources is leeg.' >>"$diagnosis"; return 1; }
  /usr/bin/find "$electron_app/Contents/Frameworks" -mindepth 1 -print -quit | /usr/bin/grep -q . || { echo 'Electron.app/Contents/Frameworks is leeg.' >>"$diagnosis"; return 1; }

  framework_current="$electron_app/Contents/Frameworks/Electron Framework.framework/Versions/Current"
  if [ ! -L "$framework_current" ]; then echo 'Frameworksymlink Versions/Current ontbreekt; ZIP-extractie heeft de bundlelayout beschadigd.' >>"$diagnosis"; return 1; fi

  # Prove the critical CodeResources file survived extraction byte-for-byte.
  archive_hash="$(/usr/bin/unzip -p "$zip" 'Electron.app/Contents/_CodeSignature/CodeResources' | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
  extracted_hash="$(/usr/bin/shasum -a 256 "$electron_app/Contents/_CodeSignature/CodeResources" | /usr/bin/awk '{print $1}')"
  if [ -z "$archive_hash" ] || [ "$archive_hash" != "$extracted_hash" ]; then
    echo 'Electron.app/Contents/_CodeSignature/CodeResources wijkt na extractie af van het ZIP-archief.' >>"$diagnosis"
    return 1
  fi
}

verify_electron_bundle() {
  local electron_app="$1" log="$2" binary architecture identifier authority team
  binary="$electron_app/Contents/MacOS/Electron"
  architecture="$(/usr/bin/file "$binary")"
  echo "$architecture" | /usr/bin/grep -Eq 'arm64|universal' || { echo "Onjuiste executable-architectuur: $architecture" >"$log"; return 1; }

  # This must pass as a complete, untouched official bundle. The concrete
  # missing-CodeResources error is never accepted or bypassed.
  /usr/bin/codesign --verify --deep --strict --verbose=4 "$electron_app" >"$log" 2>&1 || return 1

  identifier="$(/usr/bin/codesign -dv --verbose=4 "$electron_app" 2>&1 | /usr/bin/sed -n 's/^Identifier=//p' | /usr/bin/head -1)"
  authority="$(/usr/bin/codesign -dv --verbose=4 "$electron_app" 2>&1 | /usr/bin/sed -n 's/^Authority=//p' | /usr/bin/head -1)"
  team="$(/usr/bin/codesign -dv --verbose=4 "$electron_app" 2>&1 | /usr/bin/sed -n 's/^TeamIdentifier=//p' | /usr/bin/head -1)"
  [ -n "$identifier" ] && [ -n "$team" ] && echo "$authority" | /usr/bin/grep -q 'Developer ID Application'
}

install_runtime() {
  local work zip sums extracted electron_app pair zip_url sums_url ok verify_log listing diagnosis
  work="$(/usr/bin/mktemp -d -t grabbr-runtime)"
  zip="$work/$ARCHIVE"
  sums="$work/SHASUMS256.txt"
  extracted="$work/extracted"
  verify_log="$work/codesign.log"
  listing="$work/archive-list.txt"
  diagnosis="$work/preflight.txt"
  /bin/mkdir -p "$extracted" "$RUNTIME_DIR"
  trap '/bin/rm -rf "$work"' EXIT
  ok=0

  # Each runtime candidate must match the official SHASUMS256 manifest. A
  # mirror is accepted only when its bytes match that signed release artifact.
  for pair in \
    "https://github.com/electron/electron/releases/download/v$VERSION/$ARCHIVE|https://github.com/electron/electron/releases/download/v$VERSION/SHASUMS256.txt" \
    "https://mirrors.huaweicloud.com/electron/$VERSION/$ARCHIVE|https://mirrors.huaweicloud.com/electron/$VERSION/SHASUMS256.txt" \
    "https://downloads.sourceforge.net/project/electron.mirror/v$VERSION/$ARCHIVE|https://github.com/electron/electron/releases/download/v$VERSION/SHASUMS256.txt"; do
    zip_url="${pair%%|*}"; sums_url="${pair#*|}"
    /bin/rm -f "$zip" "$sums"
    if /usr/bin/curl --fail --location --retry 2 --connect-timeout 20 --output "$zip" "$zip_url" && \
       /usr/bin/curl --fail --location --retry 2 --connect-timeout 20 --output "$sums" "$sums_url" && \
       verify_official_archive "$zip" "$sums"; then
      ok=1; break
    fi
  done
  if [ "$ok" -ne 1 ]; then
    show_error "De officiële Electron arm64-runtime kon niet cryptografisch worden geverifieerd. De download is niet geïnstalleerd."
    exit 1
  fi
  if ! verify_archive_layout "$zip" "$listing"; then
    show_error "Het cryptografisch geverifieerde Electron-ZIP heeft niet de verwachte volledige top-level Electron.app-layout. Vereist zijn onder meer Contents/Resources, Contents/Frameworks en Contents/_CodeSignature/CodeResources. Het archief is niet uitgepakt of geïnstalleerd."
    exit 1
  fi

  # Electron release ZIPs encode executable modes and framework symlinks as
  # standard ZIP Unix attributes. System unzip restores those entries exactly.
  # Do not use ditto --rsrc here: it caused incomplete Electron.app resource
  # layouts on affected Macs, including a missing _CodeSignature/CodeResources.
  /usr/bin/unzip -q "$zip" -d "$extracted"
  electron_app="$extracted/Electron.app"
  if ! preflight_extracted_bundle "$electron_app" "$zip" "$diagnosis"; then
    details="$(/bin/cat "$diagnosis" 2>/dev/null || true)"
    show_error "De uitgepakte Electron.app is onvolledig of beschadigd vóór de codehandtekeningcontrole.\n\n$details"
    exit 1
  fi
  if ! verify_electron_bundle "$electron_app" "$verify_log"; then
    details="$(/usr/bin/tail -30 "$verify_log" 2>/dev/null || true)"
    show_error "De complete officiële Electron.app heeft de codehandtekeningcontrole niet doorstaan.\n\n$details"
    exit 1
  fi

  /bin/rm -rf "$RUNTIME_APP"
  /usr/bin/ditto --rsrc --extattr "$electron_app" "$RUNTIME_APP"
  # The official artifact has now passed both release-hash and Developer ID
  # verification. Adding Grabbr's Resources/app changes the sealed bundle, so
  # re-seal the resulting unsigned test bundle with an ad-hoc signature.
  /bin/rm -rf "$RUNTIME_APP/Contents/Resources/app"
  /bin/mkdir -p "$RUNTIME_APP/Contents/Resources/app"
  /usr/bin/ditto "$APP_SOURCE" "$RUNTIME_APP/Contents/Resources/app"
  /usr/bin/xattr -dr com.apple.quarantine "$RUNTIME_APP" >/dev/null 2>&1 || true
  /usr/bin/codesign --force --deep --sign - --preserve-metadata=entitlements,requirements,flags,runtime "$RUNTIME_APP" >/dev/null 2>&1
  /usr/bin/codesign --verify --deep --strict "$RUNTIME_APP" >/dev/null 2>&1
  /bin/rm -rf "$work"
  trap - EXIT
}

verify_cached_runtime() {
  [ -x "$RUNTIME_BIN" ] || return 1
  /usr/bin/file "$RUNTIME_BIN" | /usr/bin/grep -Eq 'arm64|universal' || return 1
  /usr/bin/codesign --verify --deep --strict "$RUNTIME_APP" >/dev/null 2>&1
}

# A cache made by the 0.7.0 launcher may have an invalid resource seal because
# that launcher modified Electron.app after verification. Reject and replace it.
if ! verify_cached_runtime; then
  /bin/rm -rf "$RUNTIME_APP"
  install_runtime
fi

/bin/rm -rf "$RUNTIME_APP/Contents/Resources/app"
/bin/mkdir -p "$RUNTIME_APP/Contents/Resources/app"
/usr/bin/ditto "$APP_SOURCE" "$RUNTIME_APP/Contents/Resources/app"
/usr/bin/xattr -dr com.apple.quarantine "$RUNTIME_APP" >/dev/null 2>&1 || true
/usr/bin/codesign --force --deep --sign - --preserve-metadata=entitlements,requirements,flags,runtime "$RUNTIME_APP" >/dev/null 2>&1
/usr/bin/codesign --verify --deep --strict "$RUNTIME_APP" >/dev/null 2>&1
/usr/bin/open -n "$RUNTIME_APP"
exit 0
